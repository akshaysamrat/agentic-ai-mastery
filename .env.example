# Which provider to use: nvidia or gemini (both have free access)
PROVIDER=nvidia

# NVIDIA (build.nvidia.com): open any model page -> "Get API Key"
NVIDIA_API_KEY=nvapi-paste-your-key-here
# Copy a model ID from its build.nvidia.com page (shown in the code sample)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paid, optional, later: Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
